# Web frontend (Next.js standalone) for Azure Container Apps.
#
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME, so every environment gets its
# own image built with its own --build-arg set — use scripts/deploy_web_azure.sh,
# which reads web/.env.azure.<env>.local. An incomplete set fails the build on
# purpose: constants.ts has no address fallbacks and module-level
# `new Contract('')` throws (see the prod-build-needs-env note in CLAUDE.md).
# NEXT_PUBLIC_VERCEL_ENV must be passed explicitly (production|preview) — Vercel
# injects it automatically, self-hosted builds do not, and constants.ts uses it
# to keep the missing-address check strict.
FROM node:22-alpine AS deps
WORKDIR /app
# node-usb (transitive dep of the wallet kit's hardware-wallet transports) has
# no musl prebuilds — it compiles via node-gyp and needs python + libusb/udev
# headers. Build-stage only; nothing here reaches the runtime image.
RUN apk add --no-cache python3 make g++ linux-headers eudev-dev libusb-dev
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_VERCEL_ENV
ARG NEXT_PUBLIC_MARKET_ID
ARG NEXT_PUBLIC_VAULT_ID
ARG NEXT_PUBLIC_NOERACLE_SHIM_ID
ARG NEXT_PUBLIC_NOETHER_ROUTER_ID
ARG NEXT_PUBLIC_USDC_TOKEN_ID
ARG NEXT_PUBLIC_NOE_TOKEN_ID
ARG NEXT_PUBLIC_VAULT_FACTORY_ID
ARG NEXT_PUBLIC_REFERRAL_ID
ARG NEXT_PUBLIC_NOETHER_API_URL
ARG NEXT_PUBLIC_NOERACLE_API_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_ADMIN_PUBLIC_KEY
ARG NEXT_PUBLIC_USDC_ASSET_CODE
ARG NEXT_PUBLIC_USDC_ISSUER
ARG NEXT_PUBLIC_NOE_ASSET_CODE
ARG NEXT_PUBLIC_NOE_ISSUER
ARG NEXT_PUBLIC_REFERRAL_CREATOR_ALLOWLIST
ARG NEXT_PUBLIC_GEOBLOCK_ENABLED
ARG NEXT_PUBLIC_NETWORK_LABEL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_UMAMI_URL
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID
ARG NEXT_PUBLIC_ADMIN_ENABLED
ENV NEXT_PUBLIC_VERCEL_ENV=$NEXT_PUBLIC_VERCEL_ENV \
    NEXT_PUBLIC_MARKET_ID=$NEXT_PUBLIC_MARKET_ID \
    NEXT_PUBLIC_VAULT_ID=$NEXT_PUBLIC_VAULT_ID \
    NEXT_PUBLIC_NOERACLE_SHIM_ID=$NEXT_PUBLIC_NOERACLE_SHIM_ID \
    NEXT_PUBLIC_NOETHER_ROUTER_ID=$NEXT_PUBLIC_NOETHER_ROUTER_ID \
    NEXT_PUBLIC_USDC_TOKEN_ID=$NEXT_PUBLIC_USDC_TOKEN_ID \
    NEXT_PUBLIC_NOE_TOKEN_ID=$NEXT_PUBLIC_NOE_TOKEN_ID \
    NEXT_PUBLIC_VAULT_FACTORY_ID=$NEXT_PUBLIC_VAULT_FACTORY_ID \
    NEXT_PUBLIC_REFERRAL_ID=$NEXT_PUBLIC_REFERRAL_ID \
    NEXT_PUBLIC_NOETHER_API_URL=$NEXT_PUBLIC_NOETHER_API_URL \
    NEXT_PUBLIC_NOERACLE_API_URL=$NEXT_PUBLIC_NOERACLE_API_URL \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID \
    NEXT_PUBLIC_ADMIN_PUBLIC_KEY=$NEXT_PUBLIC_ADMIN_PUBLIC_KEY \
    NEXT_PUBLIC_USDC_ASSET_CODE=$NEXT_PUBLIC_USDC_ASSET_CODE \
    NEXT_PUBLIC_USDC_ISSUER=$NEXT_PUBLIC_USDC_ISSUER \
    NEXT_PUBLIC_NOE_ASSET_CODE=$NEXT_PUBLIC_NOE_ASSET_CODE \
    NEXT_PUBLIC_NOE_ISSUER=$NEXT_PUBLIC_NOE_ISSUER \
    NEXT_PUBLIC_REFERRAL_CREATOR_ALLOWLIST=$NEXT_PUBLIC_REFERRAL_CREATOR_ALLOWLIST \
    NEXT_PUBLIC_GEOBLOCK_ENABLED=$NEXT_PUBLIC_GEOBLOCK_ENABLED \
    NEXT_PUBLIC_NETWORK_LABEL=$NEXT_PUBLIC_NETWORK_LABEL \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_UMAMI_URL=$NEXT_PUBLIC_UMAMI_URL \
    NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID \
    NEXT_PUBLIC_ADMIN_ENABLED=$NEXT_PUBLIC_ADMIN_ENABLED
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
