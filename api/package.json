{
  "name": "@noether/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST + WebSocket gateway for Noether. Reads from the indexer's libsql, prepares + relays Soroban transactions for trading.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@libsql/client": "^0.17.0",
    "@noether/shared": "*",
    "@noether/types": "*",
    "@stellar/stellar-sdk": "^14.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
