{
  "name": "@noether/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST + WebSocket gateway for Noether. Reads from the indexer's Postgres (Supabase), prepares + relays Soroban transactions for trading.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "@noether/db": "*",
    "@noether/shared": "*",
    "@noether/types": "*",
    "@stellar/stellar-sdk": "^14.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
