# ============================================================================
# Noether Protocol — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git! Only .env.example should be committed.
#
# Per-service overrides go in <service>/.env (api/.env, indexer/.env, etc.).
# Values defined here are common defaults shared across services.
# ============================================================================

# ----------------------------------------------------------------------------
# Stellar / Soroban Network
# ----------------------------------------------------------------------------
NETWORK=testnet
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC URL.
# Recommended: a paid endpoint (see docs/RPC.md). The public endpoint is
# rate-limited and unsuitable when the indexer and keeper both run.
#
# For active failover, set SOROBAN_RPC_URLS to a comma-separated list
# (primary first). When both are set, SOROBAN_RPC_URLS wins.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
# SOROBAN_RPC_URLS="https://primary.example,https://soroban-testnet.stellar.org"
HORIZON_URL="https://horizon-testnet.stellar.org"

# ----------------------------------------------------------------------------
# Admin / Deployer Credentials
# ----------------------------------------------------------------------------
ADMIN_SECRET_KEY=S...YOUR_SECRET_KEY_HERE...
ADMIN_PUBLIC_KEY=G...YOUR_PUBLIC_KEY_HERE...
IDENTITY_NAME=noether_admin

# ----------------------------------------------------------------------------
# Noeracle oracle (pull-based, signed). The market reads prices via the
# noeracle_shim (SEP-40) which proxies to Noeracle's get_price_pers.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_NOERACLE_SHIM_ID=
NEXT_PUBLIC_NOERACLE_ID=CAYIP67UDVX5UPXGN3XDAWVIEFBAVG6G7LUESEOU3NUQKTWN55W34YBG
NEXT_PUBLIC_NOETHER_ROUTER_ID=
NEXT_PUBLIC_NOERACLE_API_URL=https://api.noeracle.org

# ----------------------------------------------------------------------------
# Indexer
# ----------------------------------------------------------------------------
# libsql / Turso connection string.
# For local dev with file:// the path is resolved relative to the indexer
# package directory (when running via `npm -w @noether/indexer ...`).
# For absolute safety, use an absolute path.
LIBSQL_URL="file:./data/indexer.db"
LIBSQL_AUTH_TOKEN=

# Polling interval (ms) for Soroban getEvents
INDEXER_POLL_INTERVAL_MS=2000

# Cold-start: number of ledgers to look back if no cursor exists yet
INDEXER_COLD_START_LEDGERS=20000

# ----------------------------------------------------------------------------
# API Gateway
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info

# Pepper applied when hashing API key secrets at rest.
# Generate with: openssl rand -hex 32
# Must stay stable across restarts — rotating it invalidates every issued key.
# REQUIRED in production (NODE_ENV=production): the API refuses to boot when
# this is unset or left at the built-in dev default.
API_HMAC_PEPPER=

# Closed-beta allowlist — comma-separated Stellar G... addresses permitted to
# mint API keys via /v1/keys. Unset = key issuance open to anyone (dev only).
# REQUIRED in production: the API refuses to boot when this is unset/empty.
API_KEY_ALLOWLIST=

# CORS — comma-separated origins, or "*" for dev.
# REQUIRED in production: the API refuses to boot with the "*" wildcard;
# set the real frontend origin(s), e.g. https://noether.exchange
API_CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------------------------
# WalletConnect Cloud project ID (https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Web faucet
ADMIN_SECRET_KEY_WEB=

# Secret the Vercel cron scheduler must present as
# `Authorization: Bearer <secret>` to /api/cron/sync-leaderboard.
# Generate with: openssl rand -hex 32
# When unset, the cron route rejects every request with 401 (fail closed).
CRON_SECRET=

# Contract address overrides (P3-4/D-4) — set to re-point a service
# WITHOUT rebuilding its Docker image (the manifest is baked in at build).
# Names: CONTRACT_<KEY> in SCREAMING_SNAKE. An override always wins.
# CONTRACT_MARKET=CC...
# CONTRACT_VAULT=CD...
# CONTRACT_NOETHER_ROUTER=CC...
# CONTRACT_NOERACLE_SHIM=CB...
# CONTRACT_VAULT_FACTORY=CC...
# CONTRACT_REFERRAL=CA...
