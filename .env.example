# ============================================================================
# Noether Protocol — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git! Only .env.example should be committed.
#
# Per-service overrides go in <service>/.env (api/.env, indexer/.env, etc.).
# Values defined here are common defaults shared across services.
# ============================================================================

# ----------------------------------------------------------------------------
# Stellar / Soroban Network
# ----------------------------------------------------------------------------
NETWORK=testnet
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC URL.
# Recommended: a paid endpoint (see docs/RPC.md). The public endpoint is
# rate-limited and unsuitable when the indexer and keeper both run.
#
# For active failover, set SOROBAN_RPC_URLS to a comma-separated list
# (primary first). When both are set, SOROBAN_RPC_URLS wins.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
# SOROBAN_RPC_URLS="https://primary.example,https://soroban-testnet.stellar.org"
HORIZON_URL="https://horizon-testnet.stellar.org"

# ----------------------------------------------------------------------------
# Admin / Deployer Credentials
# ----------------------------------------------------------------------------
ADMIN_SECRET_KEY=S...YOUR_SECRET_KEY_HERE...
ADMIN_PUBLIC_KEY=G...YOUR_PUBLIC_KEY_HERE...
IDENTITY_NAME=noether_admin

# ----------------------------------------------------------------------------
# Noeracle oracle (pull-based, signed). The market reads prices via the
# noeracle_shim (SEP-40) which proxies to Noeracle's get_price_pers.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_NOERACLE_SHIM_ID=
NEXT_PUBLIC_NOERACLE_ID=CBTO5K2NLG2KYHQDL5ME4SWFQ5GRR7GVU4DFATOXGVS3OUJJDFF2YYNS
NEXT_PUBLIC_NOETHER_ROUTER_ID=
NEXT_PUBLIC_NOERACLE_API_URL=https://api.noeracle.org

# ----------------------------------------------------------------------------
# Indexer + API database (Postgres / Supabase)
# ----------------------------------------------------------------------------
# Shared by @noether/indexer (writer) and @noether/api (reader + api_keys).
# REQUIRED — there is no local-file fallback (the libsql LIBSQL_URL /
# LIBSQL_AUTH_TOKEN pair was retired in the 2026-07 Supabase migration).
#
# Supabase: use the SESSION-mode Supavisor pooler URL —
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Never the direct db.<ref>.supabase.co host (IPv6-only) and never the
# transaction pooler on :6543 (breaks session state for long-lived services).
#
# Do NOT add uselibpqcompat=true. It was previously recommended here to stop
# node-postgres rejecting the pooler's chain, but inside pg-connection-string
# that flag resolves sslmode=require to rejectUnauthorized:false — measured
# live as tls.authorized === false. The link was encrypted but UNAUTHENTICATED,
# so anyone on-path to the pooler could present their own certificate and read
# or rewrite every query. Set DATABASE_CA_CERT below instead.
#
# Local dev: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17-alpine
DATABASE_URL="postgresql://postgres:dev@localhost:5432/postgres"

# Polling interval (ms) for Soroban getEvents
INDEXER_POLL_INTERVAL_MS=2000

# Cold-start: number of ledgers to look back if no cursor exists yet
INDEXER_COLD_START_LEDGERS=20000

# ----------------------------------------------------------------------------
# API Gateway
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info

# Pepper applied when hashing API key secrets at rest.
# Generate with: openssl rand -hex 32
# Must stay stable across restarts — rotating it invalidates every issued key.
# REQUIRED in production (NODE_ENV=production): the API refuses to boot when
# this is unset or left at the built-in dev default.
API_HMAC_PEPPER=

# Closed-beta allowlist — comma-separated Stellar G... addresses permitted to
# mint API keys via /v1/keys. Unset = key issuance open to anyone (dev only).
# REQUIRED in production: the API refuses to boot when this is unset/empty.
# Workstream A transition: wallets APPROVED in access_grants pass the gate
# too (union) — this env var retires once the DB migration is verified.
API_KEY_ALLOWLIST=

# ── Workstream A access system (waitlist + admin approvals) ──

# Cloudflare Turnstile SERVER secret for POST /v1/waitlist. Unset = the join
# endpoint answers 503 (fail loud, never silently bot-open). Cloudflare's
# always-pass test secret for local dev: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Azure Communication Services — approval notification email. Both unset =
# approvals simply never email (admin panel shows unsent; resend later).
# Connection string: az communication list-key; sender: the MailFrom address
# of the provisioned email domain (DoNotReply@<id>.azurecomm.net for the
# Azure-managed domain).
ACS_CONNECTION_STRING=
ACS_SENDER=

# Wallets allowed into /v1/admin/* (comma-separated G... addresses — the
# founders' PERSONAL wallets, never the contract admin key). Empty = every
# admin route fails closed with 403.
ADMIN_WALLETS=

# Cloudflare Turnstile SITE key, inlined into the web build for the waitlist
# widget on /audit. Dev fallback (unset outside production) is Cloudflare's
# always-pass test sitekey.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CORS — comma-separated origins, or "*" for dev.
# REQUIRED in production: the API refuses to boot with the "*" wildcard;
# set the real frontend origin(s), e.g. https://noether.exchange
API_CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------------------------
# WalletConnect Cloud project ID (https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Web faucet
ADMIN_SECRET_KEY_WEB=

# Gateway base URL for the web app (leaderboard proxy, vaults, referrals,
# api-keys pages). Prod/staging set this in Vercel.
NEXT_PUBLIC_NOETHER_API_URL=http://localhost:4000

# (CRON_SECRET retired 2026-07 — the leaderboard cron + separate Turso web DB
# were replaced by the indexer→gateway pipeline; /api/leaderboard now proxies
# /v1/leaderboard.)

# Contract address overrides (P3-4/D-4) — set to re-point a service
# WITHOUT rebuilding its Docker image (the manifest is baked in at build).
# Names: CONTRACT_<KEY> in SCREAMING_SNAKE. An override always wins.
# CONTRACT_MARKET=CC...
# CONTRACT_VAULT=CD...
# CONTRACT_NOETHER_ROUTER=CC...
# CONTRACT_NOERACLE_SHIM=CB...
# CONTRACT_VAULT_FACTORY=CC...
# CONTRACT_REFERRAL=CA...

# Gateway geo-restriction (P6-4) — set API_GEOBLOCK=1 to enforce; country from
# GEO_COUNTRY_HEADER (default cf-ipcountry). Blocks trading endpoints from US/
# Ontario/OFAC jurisdictions with 451.
# API_GEOBLOCK=1

# PEM of the CA that signs the database server's certificate. Supplying this
# makes the connection authenticated, not merely encrypted — without it the
# pool logs a warning and accepts whatever certificate it is handed.
#
# Supabase's pooler chains to "Supabase Root 2021 CA", which is NOT in any
# public trust store, so sslmode=verify-full cannot work on its own. Download
# the cert from the Supabase dashboard (Settings -> Database -> SSL
# Configuration). Expected root fingerprint (SHA-256):
#   80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA
# Passed as PEM text rather than a file path so rotation is an env change only.
DATABASE_CA_CERT=
