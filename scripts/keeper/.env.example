# Noether Keeper Bot Configuration
# Copy this file to .env and fill in your values

# Keeper's Stellar secret key (for signing oracle pushes + liquidations).
# Use a DEDICATED keeper key. Do NOT reuse ADMIN_SECRET_KEY — the admin key
# is the asset issuer and market admin; the keeper falls back to it only as
# a last resort, warns loudly on testnet, and refuses to start on mainnet.
KEEPER_SECRET_KEY=S...

# Network configuration (testnet or mainnet)
NETWORK=testnet

# RPC endpoints. SOROBAN_RPC_URLS (comma-separated, primary first) enables
# failover rotation on transient errors; single-var fallbacks still work.
# SOROBAN_RPC_URLS=https://your-paid-rpc.example.com,https://soroban-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Keeper timing
POLL_INTERVAL_MS=5000             # Scan cadence (liquidations/orders)
ORACLE_UPDATE_INTERVAL_MS=30000   # Oracle push cadence

# Reliability
WATCHDOG_TIMEOUT_MS=180000        # exit(1) if no cycle completes in this window (Railway restarts)
ALERT_ERROR_STREAK=5              # alert after N consecutive cycle errors
KEEPER_STATE_FILE=./keeper-state.json  # persisted circuit-breaker state (last pushed prices)

# Alerting (optional — console-only if unset)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100123456789

# Publish-path defenses
# REFERENCE_TICKER_URL=https://api.binance.com/api/v3/ticker/price
# REFERENCE_DIVERGENCE_PCT=5      # skip push when attestation diverges > this % from reference
# MAX_MOVE_PCT_BTC=10             # per-push-interval jump bounds (defaults: BTC/ETH 10, XLM 20)
# MAX_MOVE_PCT_ETH=10
# MAX_MOVE_PCT_XLM=20

# Contract addresses will be loaded from contracts.json
# Or you can set them manually:
# NEXT_PUBLIC_MARKET_ID=C...
# NEXT_PUBLIC_NOERACLE_ID=C...
# NEXT_PUBLIC_VAULT_ID=C...

# Stork secondary oracle (T3-D1) — fail-open: unset = Noeracle-only
# STORK_API_KEY=                  # Basic auth token from Stork (sales@stork.network)
# STORK_REST_URL=https://rest.jp.stork-oracle.network
# STORK_MAX_DIVERGENCE_PCT=1.5    # block a push when Noeracle vs Stork diverges > this %
# STORK_MAX_AGE_MS=120000         # ignore cached Stork prices older than this

# Oracle-health heartbeat (T3-D1) — fail-open: unset = disabled
# KEEPER_HEARTBEAT_URL=https://<api-host>/v1/oracle/heartbeat
# KEEPER_HEARTBEAT_SECRET=        # must match the api's KEEPER_HEARTBEAT_SECRET
