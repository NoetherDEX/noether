# ═══════════════════════════════════════════════════════════════════════════════
# .env.staging — GREEN / STAGING deployment (blue-green)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.staging` (which is git-ignored) and fill in the two
# fresh keypairs below. scripts/deploy_staging.sh reads `.env.staging`, deploys
# the green contracts, and fills in the GREEN_* contract addresses for you.
#
# This is a SEPARATE, parallel deployment. It does NOT touch the live contracts
# or the production keeper. Testnet only.
#
#   cp .env.staging.example .env.staging      # then edit .env.staging
#
# NEVER commit .env.staging — it holds secret keys. (.env* is git-ignored.)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Network (testnet) ──────────────────────────────────────────────────────────
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── YOU FILL THESE IN: two fresh, friendbot-funded keypairs ─────────────────────
# Generate + fund (see the runbook the assistant gives you), then paste here.
#
# Staging ADMIN — deploys & owns the green market/vault/router; issues green NOE.
STAGING_ADMIN_PUBLIC_KEY=G...PASTE_PUBLIC...
STAGING_ADMIN_SECRET_KEY=S...PASTE_SECRET...
#
# Staging KEEPER — pushes prices to Noeracle + runs liquidations/orders for green.
# MUST be different from the admin and from the live keeper (avoids seq conflicts).
STAGING_KEEPER_PUBLIC_KEY=G...PASTE_PUBLIC...
STAGING_KEEPER_SECRET_KEY=S...PASTE_SECRET...

# ── REUSED (shared, already deployed — do not change) ───────────────────────────
NEXT_PUBLIC_NOERACLE_SHIM_ID=CDHIGZLUPKSY747I3TLSKB4F6AQXQV4T54AKSQNFAEILUB6ROVAVUJHN
NEXT_PUBLIC_NOERACLE_ID=CAYIP67UDVX5UPXGN3XDAWVIEFBAVG6G7LUESEOU3NUQKTWN55W34YBG
NEXT_PUBLIC_USDC_TOKEN_ID=CA63EPM4EEXUVUANF6FQUJEJ37RWRYIXCARWFXYUMPP7RLZWFNLTVNR4
NEXT_PUBLIC_NOERACLE_API_URL=https://api.noeracle.org

# ── GREEN contract addresses (LEAVE BLANK — deploy_staging.sh fills these) ───────
GREEN_NOE_TOKEN_ID=
GREEN_VAULT_ID=
GREEN_MARKET_ID=
GREEN_ROUTER_ID=
